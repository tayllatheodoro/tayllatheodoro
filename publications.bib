@article{ARMATO2024107832,
title = {Imaging in pleural Mesothelioma: A review of the 16th International Conference of the International Mesothelioma Interest Group},
journal = {Lung Cancer},
volume = {193},
pages = {107832},
year = {2024},
issn = {0169-5002},
doi = {https://doi.org/10.1016/j.lungcan.2024.107832},
url = {https://www.sciencedirect.com/science/article/pii/S0169500224003660},
author = {Samuel G. Armato and Sharyn I. Katz and Thomas Frauenfelder and Geeshath Jayasekera and Annamaria Catino and Kevin G. Blyth and Taylla Theodoro and Pascal Rousset and Kristiaan Nackaerts and Isabelle Opitz},
keywords = {Mesothelioma, Image protocol harmonization, Surgical planning, Malignant pleural effusion, Transfer learning, Peritoneal mesothelioma, Perfusion MRI},
abstract = {Imaging continues to gain a greater role in the assessment and clinical management of patients with mesothelioma. This communication summarizes the oral presentations from the imaging session at the 2023 International Conference of the International Mesothelioma Interest Group (iMig), which was held in Lille, France from June 26 to 28, 2023. Topics at this session included an overview of best practices for clinical imaging of mesothelioma as reported by an iMig consensus panel, emerging imaging techniques for surgical planning, radiologic assessment of malignant pleural effusion, a radiomics-based transfer learning model to predict patient response to treatment, automated assessment of early contrast enhancement, and tumor thickness for response assessment in peritoneal mesothelioma.}
}


